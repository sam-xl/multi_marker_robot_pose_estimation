<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>multi_marker_robot_pose_estimation</name>
  <version>0.1.1</version>
  <description>Package to estimate the robot pose</description>
  <maintainer email="J.C.vanBrakel@tudelft.nl">Jasper van Brakel</maintainer>
  <license>Apache-2.0</license>

  <depend>tf2_ros_py</depend>
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>aruco_interfaces</depend>
  <depend>python3-numpy</depend>
  <depend>multi_marker_robot_pose_estimation_interfaces</depend>
  <depend>python3-transforms3d</depend>
  <depend>cv_bridge</depend>
  <depend>rcl_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>message_filters</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <build_depend>ament_virtualenv</build_depend>

  <export>
    <build_type>ament_python</build_type>
    <pip_requirements>requirements.txt</pip_requirements>
  </export>

</package>
